<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">
    
    <!-- FrontServlet -->
    <servlet>
        <servlet-name>FrontServlet</servlet-name>
        <servlet-class>com.framework.servlet.FrontServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
        <!-- Sprint 10 : upload de fichiers. Déclaré explicitement ici (et pas
             seulement via @MultipartConfig sur la classe) pour que request.getPart()
             fonctionne quel que soit le mode de déploiement. -->
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>52428800</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    
    <!-- Mappings pour les routes dynamiques (excluent les fichiers statiques) -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/front/*</url-pattern>
    </servlet-mapping>
    
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/api/*</url-pattern>
    </servlet-mapping>

    <!-- Endpoints métier (Sprint 8) -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveEmployee</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveDepartment</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveEmployees</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveEmployeesAndDepartment</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveCompleteCompany</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveProject</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveProjectsWithTeam</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveEverything</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/saveWithOptional</url-pattern>
    </servlet-mapping>

    <!-- Autres routes dynamiques -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/dashboard</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/custom</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/page</url-pattern>
    </servlet-mapping>

    <!-- Sprint 5 : ancienne annotation @Url -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/page5</url-pattern>
    </servlet-mapping>

    <!-- Sprints 11 & 11 bis : sessions et sécurité -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/session/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/pageWithParams</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/calcul</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/zavatra/*</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/user/*</url-pattern>
    </servlet-mapping>

    <!-- Upload endpoints -->
    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/upload</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/uploadMultiple</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>FrontServlet</servlet-name>
        <url-pattern>/uploadMap</url-pattern>
    </servlet-mapping>

</web-app>